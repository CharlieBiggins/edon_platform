{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/cerebrum/coordination-state.schema.json",
  "title": "Time-gated Cerebrum institutional coordination state",
  "description": "Non-authoritative evidence graph for detecting direct and state-mediated coordination.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "tenant_id",
    "world_id",
    "decision_time",
    "world_version",
    "entities",
    "channels",
    "candidate_outcomes",
    "source_lineage",
    "state_sha256",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-cerebrum-coordination-state.v1"},
    "state_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "world_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "decision_time": {"type": "string", "format": "date-time"},
    "world_version": {"type": "integer", "minimum": 0},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"},
      "uniqueItems": true
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_communications",
        "agent_actions",
        "persistent_artifacts",
        "state_mutations",
        "resource_changes",
        "queue_changes",
        "scheduling_changes",
        "code_configuration_changes",
        "causal_dependencies",
        "artifact_lineage"
      ],
      "properties": {
        "agent_communications": {"$ref": "#/$defs/edge_array"},
        "agent_actions": {"$ref": "#/$defs/edge_array"},
        "persistent_artifacts": {"$ref": "#/$defs/edge_array"},
        "state_mutations": {"$ref": "#/$defs/edge_array"},
        "resource_changes": {"$ref": "#/$defs/edge_array"},
        "queue_changes": {"$ref": "#/$defs/edge_array"},
        "scheduling_changes": {"$ref": "#/$defs/edge_array"},
        "code_configuration_changes": {"$ref": "#/$defs/edge_array"},
        "causal_dependencies": {"$ref": "#/$defs/edge_array"},
        "artifact_lineage": {"$ref": "#/$defs/edge_array"}
      }
    },
    "candidate_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome_id", "description", "status", "evidence_refs"],
        "properties": {
          "outcome_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "status": {"enum": ["POSSIBLE", "OBSERVED", "VERIFIED", "CONTESTED"]},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "state_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_class", "state_ref"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "entity_class": {"enum": ["AGENT", "SYSTEM", "RESOURCE", "ARTIFACT", "QUEUE", "SCHEDULE"]},
        "state_ref": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "edge_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_edge"}
    },
    "evidence_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_ref",
        "target_ref",
        "relation",
        "occurred_at",
        "available_to_controller_at",
        "evidence_refs",
        "confidence"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "target_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "relation": {"type": "string", "minLength": 1, "maxLength": 200},
        "occurred_at": {"type": "string", "format": "date-time"},
        "available_to_controller_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "contested": {"type": "boolean", "default": false}
      }
    }
  }
}