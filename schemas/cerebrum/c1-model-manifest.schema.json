{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/cerebrum/c1-model-manifest.schema.json",
  "title": "C1 learned-model version manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_id", "architectural_role", "historical_name",
    "predecessor_model_id", "base_model", "model_lineage", "training_release_id",
    "training_release_sha256", "artifact_sha256", "evaluation_sha256",
    "protected_evaluation_reservation_sha256", "license_id", "safety_gate",
    "performance_gate", "transfer_gate", "protected_evaluation_complete",
    "created_by", "created_at", "status", "deployment_status",
    "institution_specific_weight_updates_required", "online_weight_updates_allowed",
    "record_sha256", "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-c1-model-manifest.v1"},
    "model_id": {"type": "string", "minLength": 1},
    "architectural_role": {"const": "C1_LEARNED_MODEL_LAYER"},
    "historical_name": {"const": "Cerebrum learned component"},
    "predecessor_model_id": {"type": ["string", "null"]},
    "base_model": {"type": "string", "minLength": 1},
    "model_lineage": {"type": "string", "minLength": 1},
    "training_release_id": {"type": "string", "minLength": 1},
    "training_release_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "adapter_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protected_evaluation_reservation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "license_id": {"type": "string", "minLength": 1},
    "safety_gate": {"enum": ["PASS", "FAIL", "HOLD", "NOT_TESTED", "NOT_APPLICABLE"]},
    "performance_gate": {"enum": ["PASS", "FAIL", "HOLD", "NOT_TESTED", "NOT_APPLICABLE"]},
    "transfer_gate": {"enum": ["PASS", "FAIL", "HOLD", "NOT_TESTED", "NOT_APPLICABLE"]},
    "protected_evaluation_complete": {"type": "boolean"},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "FROZEN_INTERNAL"},
    "deployment_status": {"const": "NOT_DEPLOYED"},
    "institution_specific_weight_updates_required": {"const": false},
    "online_weight_updates_allowed": {"const": false},
    "record_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}