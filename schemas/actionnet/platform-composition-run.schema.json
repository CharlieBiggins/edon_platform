{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/actionnet/platform-composition-run.schema.json",
  "title": "Executable ActionNet mechanism composition run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "seed", "institution_ir", "mechanism_refs", "edge_refs", "trajectory", "causal_trace", "actionability", "verification", "authoritative", "binding_authority", "run_sha256"],
  "properties": {
    "schema_version": {"const": "actionnet-composition-run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "institution_ir": {"type": "object", "required": ["institution_id", "version", "ir_sha256"]},
    "mechanism_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["mechanism_id", "version"]}},
    "edge_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "trajectory": {"type": "object", "required": ["initial_state", "events", "intermediate_states", "horizon_states", "final_state", "final_state_sha256"]},
    "causal_trace": {"type": "object"},
    "actionability": {"type": "object", "required": ["disposition", "blockers", "ir_sha256", "binding_authority"]},
    "verification": {"type": "object", "required": ["deterministic_replay", "final_state_sha256", "registered_semantics_only"]},
    "authoritative": {"const": false},
    "binding_authority": {"const": false},
    "run_sha256": {"type": "string"}
  }
}