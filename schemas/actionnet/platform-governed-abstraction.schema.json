{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/actionnet/platform-governed-abstraction.schema.json",
  "title": "Locally minimized governed ActionNet abstraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_id", "institution_ir_ref", "source_fingerprint", "local_processor", "rights_basis", "data_categories", "redaction_summary", "attestation", "mechanism_refs", "trajectory", "causal_trace", "outcome", "provenance", "retention_class", "raw_payload_stored", "authoritative", "training_eligible", "requires_privacy_review", "binding_authority", "abstraction_sha256"],
  "properties": {
    "schema_version": {"const": "actionnet-governed-abstraction.v1"},
    "intake_id": {"type": "string", "minLength": 1},
    "institution_ir_ref": {"type": "object", "required": ["institution_id", "version"]},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "local_processor": {"type": "object", "required": ["processor_id", "version"]},
    "rights_basis": {"enum": ["CONSENT", "CONTRACT", "LEGAL_OBLIGATION", "LEGITIMATE_INTEREST", "PUBLIC_SOURCE", "INTERNAL_AUTHORIZATION"]},
    "data_categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "redaction_summary": {"type": "object"},
    "attestation": {
      "type": "object",
      "required": ["authorized_for_abstraction", "direct_identifiers_removed", "minimum_necessary", "raw_payload_retained_locally", "secrets_removed"]
    },
    "mechanism_refs": {"type": "array", "minItems": 1},
    "trajectory": {"type": "object"},
    "causal_trace": {"type": "object"},
    "outcome": {"type": "object"},
    "provenance": {"type": "object"},
    "retention_class": {"type": "string"},
    "raw_payload_stored": {"const": false},
    "authoritative": {"const": false},
    "training_eligible": {"const": false},
    "requires_privacy_review": {"const": true},
    "binding_authority": {"const": false},
    "abstraction_sha256": {"type": "string"}
  }
}