{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/actionnet/global-training-release.schema.json",
  "title": "Global ActionNet offline training release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "global_record_ids", "global_record_hashes",
    "model_target", "protected_evaluation_reservation_sha256",
    "dataset_overlap_report_sha256", "release_manager_id", "created_at",
    "offline_training_only", "weight_update_authorized", "release_sha256",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "actionnet-global-training-release.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "global_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "global_record_hashes": {"type": "object"},
    "model_target": {"type": "string", "minLength": 1},
    "protected_evaluation_reservation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataset_overlap_report_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release_manager_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "offline_training_only": {"const": true},
    "weight_update_authorized": {"const": false},
    "release_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}