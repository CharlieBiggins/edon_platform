{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/actionnet/global-record.schema.json",
  "title": "Governed Global ActionNet record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "global_record_id", "source_commitment_sha256",
    "normalized_experience", "normalized_experience_sha256", "evidence_grade",
    "rights_basis", "rights_ref_sha256", "privacy_review_sha256",
    "source_review_sha256", "permitted_uses", "deidentification_attested",
    "raw_payload_included", "local_training_eligibility_verified", "approved_by",
    "created_at", "training_eligible", "record_sha256", "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "actionnet-global-record.v1"},
    "global_record_id": {"type": "string", "minLength": 1},
    "source_commitment_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "normalized_experience": {"$ref": "global-experience.schema.json"},
    "normalized_experience_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_grade": {"type": "string", "minLength": 1},
    "rights_basis": {"enum": ["CUSTOMER_CONSENT", "CONTRACTUAL_DERIVED_USE", "PUBLIC_SOURCE", "SYNTHETIC", "EXPERT_LICENSED", "FEDERATED_CONTRIBUTION"]},
    "rights_ref_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "privacy_review_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_review_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "permitted_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["TRAIN", "DEVELOPMENT", "DIAGNOSTIC"]}},
    "deidentification_attested": {"const": true},
    "raw_payload_included": {"const": false},
    "local_training_eligibility_verified": {"const": true},
    "approved_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "training_eligible": {"type": "boolean"},
    "quarantined": {"type": "boolean"},
    "record_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}