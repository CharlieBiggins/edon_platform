{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/actionnet/platform-experience.schema.json",
  "title": "Governed ActionNet product experience",
  "type": "object",
  "required": ["schema_version", "tenant_id", "experience_id", "source_type", "institution_type", "mechanism_refs", "trajectory", "causal_trace", "evidence_grade", "protected", "provenance", "authoritative", "training_eligible", "overlap_checked", "requires_review", "content_sha256", "binding_authority"],
  "properties": {
    "schema_version": {"const": "actionnet-experience.v1"},
    "tenant_id": {"type": "string"},
    "experience_id": {"type": "string"},
    "source_type": {"enum": ["SYNTHETIC", "SIMULATOR", "SOLVER", "EXPERT", "PUBLIC_SOURCE", "REAL_GOVERNED_ABSTRACTION"]},
    "institution_type": {"type": "string"},
    "mechanism_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["mechanism_id", "version"]}},
    "trajectory": {"type": "object"},
    "causal_trace": {"type": "object"},
    "counterfactual_parent_id": {"type": ["string", "null"]},
    "failure_classification": {"type": ["string", "null"]},
    "evidence_grade": {"type": "string"},
    "protected": {"type": "boolean"},
    "provenance": {"type": "object"},
    "created_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "authoritative": {"const": false},
    "training_eligible": {"type": "boolean"},
    "overlap_checked": {"type": "boolean"},
    "requires_review": {"type": "boolean"},
    "content_sha256": {"type": "string"},
    "reviews": {"type": "array"},
    "governance_events": {"type": "array"},
    "binding_authority": {"const": false}
  }
}