{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/actionnet/platform-mechanism.schema.json",
  "title": "ActionNet product mechanism",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "mechanism_id", "version", "title", "description", "specification", "domains", "evidence_grade", "source_lineage", "created_by", "created_at", "record_sha256", "binding_authority"],
  "properties": {
    "schema_version": {"const": "actionnet-mechanism.v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "mechanism_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 10},
    "specification": {
      "type": "object",
      "required": ["preconditions", "state_transitions", "dependencies", "interventions", "failure_modes", "expected_outcomes"]
    },
    "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_grade": {"enum": ["UNVERIFIED", "SYNTHETIC_VERIFIED", "SOLVER_VERIFIED", "EXPERT_REVIEWED", "SOURCE_GROUNDED", "REAL_OUTCOME"]},
    "source_lineage": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "record_sha256": {"type": "string"},
    "binding_authority": {"const": false}
  }
}