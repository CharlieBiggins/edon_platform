{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/environment/event.schema.json",
  "title": "Non-authoritative institutional environment event",
  "description": "Time-gated evidence about an agent, system, or resource. This record describes evidence or an outcome and cannot authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "world_id",
    "entity_class",
    "entity_id",
    "event_class",
    "source_id",
    "occurred_at",
    "observed_at",
    "available_to_controller_at",
    "sensitivity",
    "confidence",
    "payload",
    "provenance",
    "execution_claim",
    "binding_authority",
    "executed",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "edon-institutional-environment-event.v1"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "world_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "entity_class": {"enum": ["AGENT", "SYSTEM", "RESOURCE"]},
    "entity_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "event_class": {
      "enum": [
        "OBSERVATION",
        "PROPOSAL",
        "AVAILABILITY_CHANGE",
        "CAPACITY_CHANGE",
        "STATE_CHANGE",
        "ACTION_RECEIPT",
        "OUTCOME"
      ]
    },
    "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "occurred_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "available_to_controller_at": {"type": "string", "format": "date-time"},
    "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "payload": {"type": "object"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "custody_sha256"],
      "properties": {
        "source_type": {
          "enum": ["HUMAN_REPORT", "AGENT_MESSAGE", "SYSTEM_EVENT", "SENSOR", "ADAPTER_RECEIPT", "DERIVED"]
        },
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "custody_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "derivation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "execution_claim": {
      "enum": ["NOT_APPLICABLE", "REPORTED_UNVERIFIED", "VERIFIED_BY_AUTHORIZED_ADAPTER"]
    },
    "authorization_ref_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding_authority": {"const": false},
    "executed": {"const": false},
    "event_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_claim": {"const": "VERIFIED_BY_AUTHORIZED_ADAPTER"}
        },
        "required": ["execution_claim"]
      },
      "then": {
        "required": ["authorization_ref_sha256"]
      }
    }
  ]
}