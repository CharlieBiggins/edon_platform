{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/authority/commitment.schema.json",
  "title": "Institutional commitment ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "commitment_id", "tenant_id", "institution_id", "status",
    "issuer_ref", "beneficiary_refs", "owner_ref", "deliverable", "conditions",
    "dependency_refs", "priority", "due_at", "breach_rules", "evidence_refs",
    "created_at", "updated_at", "commitment_sha256", "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-commitment.v1"},
    "commitment_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "institution_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "ACTIVE", "AT_RISK", "BREACHED", "FULFILLED", "WAIVED", "TRANSFERRED", "CANCELLED", "COMPENSATED"]},
    "issuer_ref": {"type": "string", "minLength": 1},
    "beneficiary_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owner_ref": {"type": "string", "minLength": 1},
    "deliverable": {"type": "object"},
    "conditions": {"type": "array", "items": {"type": "object"}},
    "dependency_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "integer"},
    "due_at": {"type": "string", "format": "date-time"},
    "breach_rules": {"type": "object"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authorization_ref": {"type": "string", "minLength": 1},
    "supersedes_commitment_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "commitment_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}