{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/domain-packs/manifest.schema.json",
  "title": "Cerebrum domain-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain_pack_id",
    "version",
    "status",
    "domain",
    "ir_extensions",
    "connector_mappings",
    "kernel_policy_refs",
    "solver_refs",
    "action_schema_refs",
    "evaluation_suite_refs",
    "capability_envelope",
    "operator_view_refs",
    "acceptance_test_refs",
    "expert_reviews",
    "manifest_sha256",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-domain-pack-manifest.v1"},
    "domain_pack_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 100},
    "status": {"enum": ["DRAFT", "VALIDATED", "QUALIFIED", "SUSPENDED", "RETIRED"]},
    "domain": {"type": "string", "minLength": 1, "maxLength": 200},
    "ir_extensions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "connector_mappings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "kernel_policy_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "solver_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "action_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evaluation_suite_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capability_envelope": {"type": "object"},
    "operator_view_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_test_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expert_reviews": {"type": "array", "items": {"type": "object"}},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}