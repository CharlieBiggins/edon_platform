{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/optimization/request.schema.json",
  "title": "Non-binding capacity optimization request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "tenant_id", "scope_id", "supplies", "demands", "lanes"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "objective": {"const": "MINIMIZE_COST"},
    "supplies": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["supply_id", "capacity"]}},
    "demands": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["demand_id", "quantity"]}},
    "lanes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["supply_id", "demand_id", "unit_cost"]}},
    "require_full_demand": {"type": "boolean"},
    "state_bindings": {"type": "object"}
  }
}