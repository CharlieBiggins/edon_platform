{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/institution/compiler-input.schema.json",
  "title": "EDON Institution Compiler input",
  "type": "object",
  "required": [
    "schema_version",
    "compiler_run_id",
    "institution_id",
    "institution_version",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "edon-institution-compiler-input.v1"},
    "compiler_run_id": {"type": "string", "minLength": 1},
    "institution_id": {"type": "string", "minLength": 1},
    "institution_version": {"type": "string", "minLength": 1},
    "settings": {
      "type": "object",
      "properties": {
        "minimum_review_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "require_normative_layer": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "version", "truth_layer", "kind", "format"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "truth_layer": {"enum": ["NORMATIVE", "OPERATIONAL", "BEHAVIORAL"]},
          "kind": {"type": "string", "minLength": 1},
          "format": {"enum": ["STRUCTURED_JSON", "EDON_ANNOTATED_TEXT"]},
          "path": {"type": "string", "minLength": 1},
          "content": {},
          "locator": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "metadata": {"type": "object"}
        },
        "oneOf": [
          {"required": ["path"], "not": {"required": ["content"]}},
          {"required": ["content"], "not": {"required": ["path"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}