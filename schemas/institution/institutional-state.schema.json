{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/institution/institutional-state.schema.json",
  "title": "Canonical multidimensional institutional state",
  "description": "Versioned state that separates epistemic, authority, execution, and outcome dimensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "tenant_id",
    "institution_id",
    "state_version",
    "as_of",
    "recorded_at",
    "available_to_controller_at",
    "assertions",
    "conflicts",
    "compartment_refs",
    "provenance_refs",
    "state_sha256",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-institutional-state.v1"},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "prior_state_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "as_of": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "available_to_controller_at": {"type": "string", "format": "date-time"},
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "entity_ref", "state_path", "value", "dimensions", "owner_ref", "source_refs", "effective_from", "recorded_at", "confidence"],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "entity_ref": {"type": "string", "minLength": 1, "maxLength": 500},
          "state_path": {"type": "string", "pattern": "^/"},
          "value": {},
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["epistemic", "authority", "execution", "outcome"],
            "properties": {
              "epistemic": {"enum": ["UNKNOWN", "REPORTED", "OBSERVED", "INFERRED", "DISPUTED", "VERIFIED"]},
              "authority": {"enum": ["UNASSESSED", "PROPOSED", "APPROVAL_REQUIRED", "AUTHORIZED", "DENIED", "EXPIRED", "REVOKED"]},
              "execution": {"enum": ["NOT_STARTED", "RESERVED", "DISPATCHED", "ACKNOWLEDGED", "PARTIAL", "COMPLETED", "FAILED", "CANCELLED", "COMPENSATED"]},
              "outcome": {"enum": ["UNKNOWN", "REPORTED", "OBSERVED", "VERIFIED", "CONTESTED", "FAILED"]}
            }
          },
          "owner_ref": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
          "source_precedence": {"type": "integer"},
          "effective_from": {"type": "string", "format": "date-time"},
          "effective_until": {"type": "string", "format": "date-time"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "model_or_derivation_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
          "authorization_decision_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
          "execution_record_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
          "outcome_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "assertion_refs", "status"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "assertion_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["OPEN", "UNDER_REVIEW", "RESOLVED", "ACCEPTED_AMBIGUITY"]},
          "resolution_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "compartment_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "provenance_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "state_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}