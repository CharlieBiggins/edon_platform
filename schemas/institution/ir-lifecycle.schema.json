{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/institution/ir-lifecycle.schema.json",
  "title": "Institutional IR lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ir_id",
    "institution_id",
    "version",
    "lifecycle_status",
    "owner_ref",
    "jurisdictions",
    "compiler_version",
    "schema_ref",
    "source_refs",
    "content_sha256",
    "review_records",
    "approval_records",
    "active_plan_policy",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-institutional-ir-lifecycle.v1"},
    "ir_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 100},
    "prior_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "lifecycle_status": {"enum": ["DRAFT", "VALIDATED", "IN_REVIEW", "APPROVED", "ACTIVE", "AMENDED", "SUPERSEDED", "MIGRATING", "RETIRED"]},
    "owner_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": "string", "format": "date-time"},
    "compiler_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "schema_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
    "domain_pack_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "component_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "review_records": {"type": "array", "items": {"type": "object"}},
    "approval_records": {"type": "array", "items": {"type": "object"}},
    "unresolved_conflict_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compatible_runtime_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "compatible_connector_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "migration_ref": {"type": "string", "minLength": 1}
      }
    },
    "active_plan_policy": {"enum": ["CONTINUE", "REVALIDATE", "PAUSE", "CANCEL", "COMPENSATE", "ESCALATE"]},
    "activated_scope": {"type": "object"},
    "binding_authority": {"const": false}
  }
}