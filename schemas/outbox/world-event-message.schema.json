{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/outbox/world-event-message.schema.json",
  "title": "Transactional world-event outbox message",
  "type": "object",
  "required": ["schema_version", "topic", "event_hash", "tenant_id", "world_id", "event_id", "event_type", "actor_id", "expected_version", "resulting_version", "mutations", "authorization_ref_sha256", "source_lineage", "resulting_state_sha256"],
  "properties": {
    "schema_version": {"const": "edon-world-outbox-message.v1"},
    "topic": {"const": "world.events"},
    "event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tenant_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "expected_version": {"type": "integer", "minimum": -1},
    "resulting_version": {"type": "integer", "minimum": 0},
    "mutations": {"type": "array", "minItems": 1},
    "authorization_ref_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_lineage": {"type": "array", "items": {"type": "string"}},
    "resulting_state_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}