{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/control-graph/edge.schema.json",
  "title": "Institutional Control Graph edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edge_id",
    "tenant_id",
    "institution_id",
    "source_node_id",
    "target_node_id",
    "relationship_type",
    "lifecycle_owner",
    "effective_from",
    "recorded_at",
    "available_to_controller_at",
    "evidence_refs",
    "confidence",
    "edge_sha256",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-control-graph-edge.v1"},
    "edge_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_node_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "target_node_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "relationship_type": {
      "enum": [
        "MEMBER_OF", "HAS_ROLE", "CAN_PERFORM", "DELEGATED_BY", "AUTHORIZED_FOR",
        "OWNS", "DEPENDS_ON", "RESERVES", "CONSTRAINS", "AFFECTS", "SUPPORTED_BY",
        "DISPUTES", "PROPOSES", "AUTHORIZES", "EXECUTES", "COMPENSATES", "PRODUCES_OUTCOME"
      ]
    },
    "relationship_subtype": {"type": "string", "minLength": 1, "maxLength": 300},
    "lifecycle_owner": {"type": "string", "minLength": 1, "maxLength": 300},
    "attributes": {"type": "object"},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "available_to_controller_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "derivation_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "edge_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}