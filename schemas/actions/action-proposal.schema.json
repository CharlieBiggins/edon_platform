{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/actions/action-proposal.schema.json",
  "title": "Cerebrum non-binding action proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "tenant_id",
    "institution_id",
    "incident_id",
    "objective_ref",
    "action",
    "expected_consequences",
    "preconditions",
    "resource_requirements",
    "evidence_refs",
    "uncertainties",
    "expected_state_version",
    "ir_version",
    "policy_version",
    "reasoning_lineage",
    "authority_required",
    "reversibility",
    "created_at",
    "expires_at",
    "proposal_sha256",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-action-proposal.v1"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "incident_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "objective_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "target_ref", "parameters"],
      "properties": {
        "action_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "target_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "parameters": {"type": "object"},
        "connector_profile_ref": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "expected_consequences": {"type": "array", "items": {"type": "object"}},
    "preconditions": {"type": "array", "items": {"type": "object"}},
    "resource_requirements": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "uncertainties": {"type": "array", "items": {"type": "object"}},
    "expected_state_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "ir_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "reasoning_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "model_or_solver_ref", "input_sha256"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_or_solver_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
        "input_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "trace_ref": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "authority_required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "reversibility": {"enum": ["REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE", "UNKNOWN"]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "proposal_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}