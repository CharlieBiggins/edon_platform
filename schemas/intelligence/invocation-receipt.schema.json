{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/intelligence/invocation-receipt.schema.json",
  "title": "Model, solver, or simulator invocation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "invocation_id", "tenant_id", "institution_id",
    "routing_decision_id", "component_id", "component_identity",
    "input_sha256", "output_sha256", "graph_version", "state_version",
    "evidence_refs", "data_access_grant_id", "program_version", "tools_accessed",
    "usage", "cost", "latency_ms", "fallbacks_used", "schema_validation",
    "result_status", "trace_id", "started_at", "completed_at", "receipt_sha256",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-intelligence-invocation-receipt.v1"},
    "invocation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "institution_id": {"type": "string", "minLength": 1},
    "routing_decision_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "component_identity": {"type": "object"},
    "input_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "graph_version": {"type": "string", "minLength": 1},
    "state_version": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "data_access_grant_id": {"type": "string", "minLength": 1},
    "program_version": {"type": "string", "minLength": 1},
    "tools_accessed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "usage": {"type": "object"},
    "cost": {"type": "number", "minimum": 0},
    "latency_ms": {"type": "integer", "minimum": 0},
    "fallbacks_used": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "schema_validation": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
    "result_status": {"enum": ["SUCCESS", "TIMEOUT", "COMPONENT_UNAVAILABLE", "INVALID_OUTPUT", "SCHEMA_FAILURE", "CAPABILITY_EXCEEDED", "ACCESS_DENIED", "BUDGET_EXCEEDED", "VERIFICATION_FAILURE", "ABSTAINED", "ESCALATED"]},
    "trace_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}