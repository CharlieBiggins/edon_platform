{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/intelligence/data-access-grant.schema.json",
  "title": "Purpose-bound intelligence data-access grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "grant_id", "tenant_id", "institution_id", "component_id",
    "purpose", "allowed_resources", "permitted_fields", "sensitivity_ceiling",
    "jurisdictions", "retention_policy", "issued_at", "expires_at",
    "prohibited_uses", "non_transitive", "revocation_status", "signature",
    "grant_sha256", "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-intelligence-data-access-grant.v1"},
    "grant_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "institution_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "allowed_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "permitted_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sensitivity_ceiling": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "jurisdictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retention_policy": {"type": "object"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "prohibited_uses": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "non_transitive": {"const": true},
    "revocation_status": {"enum": ["ACTIVE", "REVOKED", "EXPIRED"]},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "signed_sha256"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"type": "string", "minLength": 1},
        "signed_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "grant_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  }
}