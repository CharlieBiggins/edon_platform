{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/gateway/connector.schema.json",
  "title": "EDON Agent Gateway connector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector_id", "tenant_id", "vendor_id", "protocol", "protocol_version",
    "endpoint", "auth_method", "credential_secret_ref", "allowed_operations",
    "allowed_targets", "mode", "sensitivity_ceiling", "data_residency",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-agent-gateway-connector.v1"},
    "connector_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "vendor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "protocol": {"enum": ["MCP", "A2A", "REST", "WEBHOOK", "FHIR_R4_SMART"]},
    "protocol_version": {"enum": ["2026-07-28", "1.0", "R4"]},
    "endpoint": {"type": "string", "pattern": "^https://"},
    "auth_method": {
      "enum": [
        "OAUTH2_CLIENT_CREDENTIALS", "OAUTH2_AUTHORIZATION_CODE", "API_KEY",
        "MTLS", "SMART_BACKEND_SERVICES", "SMART_USER", "NONE_DEV_ONLY"
      ]
    },
    "credential_secret_ref": {"type": "string", "pattern": "^(secret://.*)?$"},
    "allowed_operations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_targets": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mode": {"enum": ["SHADOW", "READ_ONLY"]},
    "sensitivity_ceiling": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "data_residency": {"type": "string", "minLength": 1},
    "enabled": {"const": false},
    "binding_authority": {"const": false}
  }
}