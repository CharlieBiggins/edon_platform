{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edon-mlgw-storm-world.v1",
  "type": "object",
  "required": [
    "world_id",
    "event_id",
    "start_time",
    "initial_customers_out",
    "crews",
    "jobs",
    "resource_fingerprint",
    "physical_scenario_fingerprint",
    "binding_authority"
  ],
  "properties": {
    "world_id": {"type": "string"},
    "event_id": {"type": "string"},
    "start_time": {"type": "string", "format": "date-time"},
    "initial_customers_out": {"type": "integer", "minimum": 0},
    "crews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["crew_id", "capabilities", "available_minute"],
        "properties": {
          "crew_id": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "available_minute": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "job_id",
          "customers_restored",
          "duration_minutes",
          "required_capability",
          "dependencies",
          "available_minute",
          "critical_weight",
          "safety_validated"
        ],
        "properties": {
          "job_id": {"type": "string"},
          "customers_restored": {"type": "integer", "minimum": 0},
          "duration_minutes": {"type": "number", "exclusiveMinimum": 0},
          "required_capability": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "available_minute": {"type": "number", "minimum": 0},
          "critical_weight": {"type": "number", "minimum": 0},
          "safety_validated": {"type": "boolean"},
          "actual_priority": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "resource_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "physical_scenario_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_authority": {"const": false}
  },
  "additionalProperties": false
}