{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.example/schemas/edon-igi-scope-v1.json",
  "title": "EDON bounded institutional intelligence scope",
  "type": "object",
  "required": [
    "schema_version",
    "scope_id",
    "version",
    "frozen",
    "status",
    "formal_environment",
    "mechanism_families",
    "task_families",
    "variation_axes",
    "profiles",
    "scope_compute_caps",
    "safety_invariants",
    "independent_transfer_requirements",
    "excluded_environment_classes",
    "evidence_tiers",
    "current_disposition",
    "universal_claim_authorized",
    "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-igi-scope.v1"},
    "scope_id": {"const": "EDON-IGI-SCOPE-001"},
    "version": {"const": "1.0.0"},
    "frozen": {"const": "2026-08-25"},
    "status": {"const": "FROZEN_DEFINITION_NO_IGI_RESULT"},
    "formal_environment": {"type": "object"},
    "mechanism_families": {"type": "array", "minItems": 12, "uniqueItems": true},
    "task_families": {"type": "array", "minItems": 8, "uniqueItems": true},
    "variation_axes": {"type": "array", "minItems": 8, "uniqueItems": true},
    "profiles": {"type": "object", "minProperties": 3},
    "scope_compute_caps": {"type": "object"},
    "safety_invariants": {"type": "array", "minItems": 10, "uniqueItems": true},
    "independent_transfer_requirements": {"type": "array", "minItems": 6, "uniqueItems": true},
    "excluded_environment_classes": {"type": "array", "minItems": 8, "uniqueItems": true},
    "evidence_tiers": {"type": "array", "minItems": 6, "uniqueItems": true},
    "current_disposition": {"type": "object"},
    "universal_claim_authorized": {"const": false},
    "binding_authority": {"const": false}
  },
  "additionalProperties": true
}