{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edon.invalid/schemas/ip/release-review.schema.json",
  "title": "EDON IP release review",
  "type": "object",
  "required": [
    "schema_version", "release_id", "release_title", "owner", "checks",
    "release_authorized", "approval_records_private", "binding_authority"
  ],
  "properties": {
    "schema_version": {"const": "edon-ip-release-review.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "release_title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "checks": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {"type": "boolean"}
    },
    "release_authorized": {"type": "boolean"},
    "approval_records_private": {"const": true},
    "binding_authority": {"const": false}
  },
  "additionalProperties": true
}